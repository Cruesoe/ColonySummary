<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PawnColumnDef>
    <defName>ColonySummary_Age</defName>
    <label>age</label>
    <workerClass>ColonySummary.PawnColumnWorker_Age</workerClass>
    <sortable>true</sortable>
    <headerTip>Biological age in years.</headerTip>
  </PawnColumnDef>

  <PawnColumnDef>
    <defName>ColonySummary_Bleeding</defName>
    <headerIcon>UI/Icons/Medical/Bleeding</headerIcon>
    <workerClass>ColonySummary.PawnColumnWorker_Bleeding</workerClass>
    <sortable>true</sortable>
    <headerTip>Bleeding. Red shows the time until death by blood loss; yellow shows the bleed rate per day when there's no risk of bleeding out soon.</headerTip>
  </PawnColumnDef>

  <PawnColumnDef>
    <defName>ColonySummary_Tend</defName>
    <label>tend</label>
    <workerClass>ColonySummary.PawnColumnWorker_Tend</workerClass>
    <sortable>true</sortable>
    <headerTip>Conditions that need tending now.</headerTip>
  </PawnColumnDef>

  <!-- Replaced at startup by one column per skill (SkillColumnGenerator) -->
  <PawnColumnDef>
    <defName>ColonySummary_Skills</defName>
    <workerClass>PawnColumnWorker_Gap</workerClass>
    <gap>0</gap>
  </PawnColumnDef>

  <!-- Keeps the last inclined skill label clear of the next column's header -->
  <PawnColumnDef>
    <defName>ColonySummary_GapSkills</defName>
    <workerClass>PawnColumnWorker_Gap</workerClass>
    <gap>16</gap>
  </PawnColumnDef>

  <PawnColumnDef>
    <defName>ColonySummary_Weapon</defName>
    <label>weapon</label>
    <workerClass>ColonySummary.PawnColumnWorker_Weapon</workerClass>
    <sortable>true</sortable>
  </PawnColumnDef>

  <PawnColumnDef>
    <defName>ColonySummary_Apparel</defName>
    <label>apparel</label>
    <workerClass>ColonySummary.PawnColumnWorker_Apparel</workerClass>
    <sortable>true</sortable>
    <headerTip>Sorts by the number of items worn.</headerTip>
  </PawnColumnDef>

  <PawnColumnDef>
    <defName>ColonySummary_ArmorSharp</defName>
    <label>sharp</label>
    <workerClass>ColonySummary.PawnColumnWorker_Armor</workerClass>
    <sortable>true</sortable>
    <headerTip>Overall sharp armor, from apparel and body.</headerTip>
  </PawnColumnDef>

  <PawnColumnDef>
    <defName>ColonySummary_ArmorBlunt</defName>
    <label>blunt</label>
    <workerClass>ColonySummary.PawnColumnWorker_Armor</workerClass>
    <sortable>true</sortable>
    <headerTip>Overall blunt armor, from apparel and body.</headerTip>
  </PawnColumnDef>

  <PawnColumnDef>
    <defName>ColonySummary_ArmorHeat</defName>
    <label>heat</label>
    <workerClass>ColonySummary.PawnColumnWorker_Armor</workerClass>
    <sortable>true</sortable>
    <headerTip>Overall heat armor, from apparel and body.</headerTip>
  </PawnColumnDef>

  <PawnColumnDef>
    <defName>ColonySummary_Comfort</defName>
    <label>comfortable</label>
    <workerClass>ColonySummary.PawnColumnWorker_Comfort</workerClass>
    <sortable>true</sortable>
    <headerTip>Comfortable temperature range. Sorts by the lowest comfortable temperature.</headerTip>
  </PawnColumnDef>
</Defs>
